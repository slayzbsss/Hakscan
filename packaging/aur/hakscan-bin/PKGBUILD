# Maintainer: slayzbsss
pkgname=hakscan-bin
pkgver=4.2
pkgrel=1
pkgdesc="Fast, self-contained web & file vulnerability scanner (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/slayzbsss/Hakscan"
license=('MIT')
provides=('hakscan')
conflicts=('hakscan')
source_x86_64=("hakscan-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/hakscan_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("hakscan-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/hakscan_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('3ba6d6181959d940a398483c1190120454bcff0c089d0dcdd91770c64a7b8654')
sha256sums_aarch64=('9ff83ac687ce7a648050d79120c3c4764e0768d2691556ea3957940f92b46d86')

package() {
  install -Dm755 hakscan "$pkgdir/usr/bin/hakscan"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}

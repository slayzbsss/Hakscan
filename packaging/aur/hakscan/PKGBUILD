# Maintainer: slayzbsss
pkgname=hakscan
pkgver=4.3
pkgrel=1
pkgdesc="Fast, self-contained web & file vulnerability scanner"
arch=('x86_64' 'aarch64')
url="https://github.com/slayzbsss/Hakscan"
license=('MIT')
makedepends=('go')
provides=('hakscan')
conflicts=('hakscan-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9d5d30db21c0208ac52ccf9c02e64770b8809d98aee1beffd41c652ddb366d17')

build() {
  cd "Hakscan-$pkgver"
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags="-s -w" -o hakscan ./cmd/hakscan
}

package() {
  cd "Hakscan-$pkgver"
  install -Dm755 hakscan "$pkgdir/usr/bin/hakscan"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
